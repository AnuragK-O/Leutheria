{
  // IntelliSense for overlay-qt/: read include paths and flags from the CMake
  // build's compile database instead of guessing (it can't find Homebrew's Qt
  // on its own). Regenerated by configuring the build, see overlay-qt/README.md.
  "C_Cpp.default.compileCommands": "${workspaceFolder}/overlay-qt/build/compile_commands.json",
  "cmake.sourceDirectory": "${workspaceFolder}/overlay-qt",
  // Without this CMake Tools configures into ${workspaceFolder}/build (its
  // default), an untracked, unignored copy of overlay-qt/build at the repo root.
  "cmake.buildDirectory": "${workspaceFolder}/overlay-qt/build"
}
